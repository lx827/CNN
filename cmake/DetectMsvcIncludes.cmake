function(cnn_compute_detect_msvc_includes)
    # 探测真实语言资源和当前控制台代码页，CMake 内部统一为 UTF-8。
    set(probe "${CMAKE_CURRENT_BINARY_DIR}/cnn_include_probe")
    file(WRITE "${probe}.hpp" "#pragma once\n")
    file(WRITE "${probe}.cpp" "#include \"${probe}.hpp\"\n")
    if(CMAKE_CXX_COMPILER)
        set(compiler "${CMAKE_CXX_COMPILER}")
    else()
        set(compiler "${CMAKE_C_COMPILER}")
    endif()
    find_program(CNN_POWERSHELL NAMES powershell REQUIRED)
    execute_process(
        COMMAND "${CNN_POWERSHELL}" -NoProfile -ExecutionPolicy Bypass -File
                "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/msvc_include_probe.ps1"
                -Compiler "${compiler}" -Source "${probe}.cpp" -Object "${probe}.obj"
        OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic ENCODING UTF-8 RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "MSVC include probe failed: ${output}${diagnostic}")
    endif()
    string(REPLACE "\\" "/" output "${output}${diagnostic}")
    string(REPLACE "\n" ";" lines "${output}")
    foreach(line IN LISTS lines)
        if(line MATCHES "cnn_include_probe.hpp")
            string(REGEX REPLACE "[A-Za-z]:/.*$" "" prefix "${line}")
            string(STRIP "${prefix}" prefix)
        endif()
    endforeach()
    if(NOT prefix)
        message(FATAL_ERROR "MSVC /showIncludes prefix probe returned no header dependency")
    endif()
    set(CMAKE_CXX_CL_SHOWINCLUDES_PREFIX "${prefix} " PARENT_SCOPE)
    set(CMAKE_C_CL_SHOWINCLUDES_PREFIX "${prefix} " PARENT_SCOPE)
    set(CMAKE_CL_SHOWINCLUDES_PREFIX "${prefix} " PARENT_SCOPE)
endfunction()
