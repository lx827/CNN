[Unit]
Description=DC24 acquisition and cloud upload
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=nbclass
Group=nbclass
StateDirectory=dc24-edge
WorkingDirectory=/var/lib/dc24-edge
EnvironmentFile=/etc/dc24-edge/edge.env
ExecStart=/usr/local/bin/dc24-edge --config /etc/dc24-edge/config.json
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=200
MemoryMax=192M
TasksMax=32
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
